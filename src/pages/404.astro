---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout noindex={true}>
  <section class="flex min-h-screen flex-col items-center justify-center px-6 text-center text-white">
    <p class="text-sm uppercase tracking-widest text-white/60">404</p>
    <h1 class="mt-6 text-5xl font-bold sm:text-7xl">Seite nicht gefunden</h1>
    <p class="mt-6 max-w-xl">Diese Seite existiert nicht oder wurde verschoben.</p>
    <a href="/" class="mt-10 border border-white px-6 py-3 transition hover:bg-white hover:text-black">Zur Startseite</a>
  </section>
</MainLayout>
