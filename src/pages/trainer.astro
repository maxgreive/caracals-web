---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout noindex={true}>
  <section
    class="min-h-screen flex flex-col items-center justify-center text-white"
  >
    <form id="training-form">
      <div class="flex flex-col gap-8 items-center">
        <label for="training-date">
          <span class="">Datum und Zeit: </span>
          <input
            type="datetime-local"
            name="datetime"
            id="training-date"
            class="mb-8 text-black"
          />
        </label>
        <label for="training-on"
          ><input
            type="radio"
            id="training-on"
            name="training"
            class="mr-4 opacity-0"
            value="TRUE"
          />✅ Findet statt!</label
        >
        <label for="training-off"
          ><input
            type="radio"
            id="training-off"
            name="training"
            class="mr-4 opacity-0"
            value="FALSE"
          />❌ Fällt aus!</label
        >
        <button type="submit" class="disabled:opacity-50" disabled>Speichern</button>
        <p id="training-message" class="min-h-6 text-center" aria-live="polite"></p>
      </div>
    </form>
  </section>
</MainLayout>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const dbEndpoint = "https://sheetdb.io/api/v1/xy859kixabhhl";

    const form = document.querySelector("form#training-form");
    const datetimeInput = document.getElementById(
      "training-date",
    ) as HTMLInputElement;
    const trainingOnRadio = document.getElementById(
      "training-on",
    ) as HTMLInputElement;
    const trainingOffRadio = document.getElementById(
      "training-off",
    ) as HTMLInputElement;
    const submitButton = form?.querySelector("button[type=submit]") as HTMLButtonElement | null;
    const message = document.getElementById("training-message");
    if (!trainingOnRadio || !trainingOffRadio || !form || !datetimeInput || !submitButton)
      return;

    fetch(dbEndpoint)
      .then((response) => {
        if (!response.ok) throw new Error("Training status could not be loaded");
        return response.json();
      })
      .then((data) => {
        const status = data[0]?.status?.toLowerCase();
        const datetime = data[0]?.datetime?.replace(/\u00A0/g, " ").trim();

        if (status === "true") {
          trainingOnRadio.checked = true;
        } else if (status === "false") {
          trainingOffRadio.checked = true;
        }
        if (datetime) {
          const date = new Date(datetime);
          if (!Number.isNaN(date.getTime())) {
            const offset = date.getTimezoneOffset();
            datetimeInput.value = new Date(date.getTime() - offset * 60000)
              .toISOString()
              .slice(0, 16);
          }
        }
        trainingOnRadio.classList.remove("opacity-0");
        trainingOffRadio.classList.remove("opacity-0");
        submitButton.disabled = false;
      })
      .catch((error) => {
        console.error("Error fetching training status:", error);
        if (message) message.textContent = "Status konnte nicht geladen werden.";
      });

    form.addEventListener("submit", async function (e) {
      e.preventDefault();
      submitButton.disabled = true;
      if (message) message.textContent = "Speichere …";

      try {
        const response = await fetch(dbEndpoint + "/id/config", {
          method: "PATCH",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify({
            status: trainingOnRadio.checked ? "TRUE" : "FALSE",
            datetime: datetimeInput.value,
          }),
        });
        if (!response.ok) throw new Error("Training status could not be saved");
        if (message) message.textContent = "Training erfolgreich geändert.";
      } catch (error) {
        console.error("Error updating training status:", error);
        if (message) message.textContent = "Änderung konnte nicht gespeichert werden.";
      } finally {
        submitButton.disabled = false;
      }
    });
  });
</script>
