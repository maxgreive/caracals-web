---
import MainLayout from "./MainLayout.astro";
import Footer from "../components/Footer.astro";
---
<MainLayout
  title={Astro.props.frontmatter?.title}
  description={Astro.props.frontmatter?.intro}
  image={Astro.props.frontmatter?.heroImage}
>
    <slot />
    <Footer containerClasses={["pt-32", "backdrop-opacity-0"]} />
</MainLayout>
