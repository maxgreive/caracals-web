---
import { getEntry } from "astro:content";
import { getOrderedSeasons } from "../utils/training";

const data = await getEntry("pages", "training");

if (!data) {
  throw new Error('Missing content entry "pages/training".');
}

if (!data.data.currentSeason || !data.data.seasons) {
  throw new Error('Training content entry is missing required season fields.');
}

const seasons = getOrderedSeasons(data.data);
---
<section id="training" class="relative bg-black pb-20 pt-32 md:pb-24 lg:pb-24 xl:pt-24">
  <div class="mx-auto max-w-7xl px-6 lg:px-12 xl:px-6 2xl:px-0">
    <div class="flex flex-wrap items-center gap-6">
      <h2 class="text-7xl font-bold text-white xl:text-8xl">Sei dabei!</h2>
      <span class="h-max rounded-full border border-white/40 px-2 py-1 text-xs tracking-wider text-white">
        {data.data.currentSeason === "summer" ? "Saison: Sommer" : "Saison: Winter"}
      </span>
    </div>
    <div class="mt-24">
      <div>
        <div class="grid gap-12 sm:grid-cols-2 xl:grid-cols-3">
          {seasons.map((season, index) => (
            <details class="border-b border-white/30 pb-8">
              <summary class="cursor-pointer list-none">
                <div class="flex flex-col gap-4 divide-y divide-white/30">
                  <span class="inline-block text-white/60">
                    {String(index + 1).padStart(3, "0")}
                    {index === 0 ? " • Aktuell" : ""}
                  </span>
                  <h3 class="bg-black pt-6 text-3xl text-white">{season.label}</h3>
                </div>
              </summary>
              <div class="toggle-panel mt-8 overflow-hidden">
                <div class="space-y-6 font-light text-white/70 md:text-lg">
                    {season.scheduleBlocks.map((block) => (
                      <div>
                        <p class="mb-4 text-white/90">{block.title}</p>
                        {block.sessions.map((session) => (
                          <p class="mb-4 last:mb-0">
                            {session.weekday}, {session.time}<br />
                            <a href={session.locationUrl} target="_blank" rel="noopener noreferrer">
                              {session.locationName}
                            </a>
                            {session.addressLines?.map((line) => (
                              <>
                                <br />
                                {line}
                              </>
                            ))}
                          </p>
                        ))}
                      </div>
                    ))}
                </div>
              </div>
            </details>
          ))}
          <div>
            <details class="border-b border-white/30 pb-8">
              <summary class="cursor-pointer list-none">
                <div class="flex flex-col gap-4 divide-y divide-white/30">
                <span class="inline-block text-white/60">003</span>
                <h3 class="bg-black pt-6 text-3xl text-white">Junior Training</h3>
                </div>
              </summary>
              <div class="toggle-panel mt-8 overflow-hidden">
                <p class="font-light text-white/70 md:text-xl">
                  Sapiente, rem debitis obcaecati facilis earum repudiandae enim ratione nihil iusto ea. Officia sint perspiciatis ad ducimus qui.
                </p>
              </div>
            </details>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
